/*
  Access-Control-Allow-Origin: *
  Access-Control-Expose-Headers: ETag, Last-Modified, Content-Length, Content-Type
/jr3d-maptest/data/*.json
  Cache-Control: public, max-age=300
/jr3d-maptest/data/*.geojson
  Cache-Control: public, max-age=300
/jr3d-maptest/data/*.js
  Cache-Control: public, max-age=300
/jr3d-maptest/data/tt/*
  Cache-Control: public, max-age=300
/jr3d-maptest/models/*
  Cache-Control: public, max-age=300
/jr3d-maptest/basis/*
  Cache-Control: public, max-age=300
/jr3d-maptest/data/badges/atlas/sha256/*
  Cache-Control: public, max-age=31536000, immutable
/jr3d-maptest/data/trackdiagrams/*
  Cache-Control: public, max-age=86400
/jr3d-maptest/app/*
  Cache-Control: public, max-age=0, must-revalidate
